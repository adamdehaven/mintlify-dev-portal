            "pages": [
              "introduction",
              "quickstart",
              "authentication"
            ]
          },
          {
            "group": "Core Concepts",
            "pages": [
              "concepts/apis-overview",
              "concepts/subscriptions",
              "concepts/metering-usage"
            ]
          },
          {
            "group": "Guides",
            "pages": [
              "guides/making-your-first-request",
              "guides/managing-subscriptions",
              "guides/monitoring-usage",
              "guides/rate-limits-and-quotas"
            ]
          },
          {
            "group": "Account & Billing",
            "pages": [
              "account/overview",
              "account/api-keys",
              "account/plans-and-pricing",
              "account/usage-and-billing"
            ]
          },
          {
            "group": "Support",
            "pages": [
              "support/faq",
              "support/troubleshooting",
              "support/changelog"
            ]
          }
        ]
      },
      {
        "tab": "API Reference",
        "groups": [
          {
            "group": "Overview",
            "pages": [
              "api-reference/introduction",
              "api-reference/authentication",
              "api-reference/errors"
            ]
          },
          {
            "group": "Endpoints",
            "pages": [
              "api-reference/endpoints/catalog",
              "api-reference/endpoints/subscriptions",
              "api-reference/endpoints/usage",
              "api-reference/endpoints/accounts"
            ]
          }
        ]
      }
    ]
  },
  "keyFeatures": [
    "API catalog and discovery",
    "Subscription management",
    "Usage metering and analytics",
    "API key management",
    "Plans and pricing tiers",
    "Developer guides and tutorials",
    "OpenAPI specifications",
    "Rate limiting and quota enforcement"
  ],
  "publicApiSurface": [
    "GET /catalog — list available APIs",
    "GET /catalog/{apiId} — get API details and specification",
    "POST /subscriptions — subscribe to an API",
    "GET /subscriptions — list active subscriptions",
    "DELETE /subscriptions/{id} — cancel a subscription",
    "GET /usage — retrieve usage metrics and metering data",
    "POST /keys — create an API key",
    "GET /keys — list API keys",
    "DELETE /keys/{id} — revoke an API key",
    "GET /account — get account details",
    "GET /plans — list available subscription plans"
  ]
}
